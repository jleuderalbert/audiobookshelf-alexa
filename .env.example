# Copy to .env (or configure as Lambda environment variables)
# and fill in the values for your audiobookshelf instance.

# Public HTTPS base URL of your audiobookshelf server.
# Must be reachable from the public internet (Alexa fetches stream URLs
# directly from this server). No trailing slash.
ABS_BASE_URL=https://abs.example.com

# Optional: base URL for stream URLs if it differs from ABS_BASE_URL. A
# self-hosted skill (server.js) can call the API over the LAN via
# ABS_BASE_URL while stream URLs must stay publicly reachable for Alexa.
# ABS_PUBLIC_URL=https://abs.example.com

# Long-lived API key created via Settings -> Users -> API Keys
# in the audiobookshelf web UI. Used as a Bearer token.
ABS_API_KEY=eyJhbGciOi...
# Or read it from a file (e.g. a Docker secret); wins over ABS_API_KEY.
# ABS_API_KEY_FILE=/run/secrets/abs_api_key

# Optional: Cloudflare Access service token, if the server is behind
# Cloudflare Access. Sent as CF-Access-Client-Id/-Secret headers on API
# calls (not on stream URLs). Set both or neither.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optional: id of the library to use by default. If unset, the first
# library returned by /api/libraries is used.
# ABS_DEFAULT_LIBRARY_ID=

# Only for the self-hosted server.js (not Lambda): the skill ID it accepts
# requests for (required) and the listen port (default 3000).
# SKILL_ID=amzn1.ask.skill....
# PORT=3000
